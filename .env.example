# Django Configuration
SECRET_KEY=django-insecure-replace-with-your-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging
LOG_LEVEL=INFO

# Integration (Discord webhook for security notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
